# ============================================================
# Ananta Platform — Production Environment Variables
#
# SETUP INSTRUCTIONS:
#   1. Copy this file:  cp .env.production.example .env.production
#   2. Fill in your real values below
#   3. NEVER commit .env.production to git — it is in .gitignore
#   4. On AWS the file lives at:  /home/ubuntu/ananta-platform/.env.production
# ============================================================

# Application
NODE_ENV=production
PORT=8080
BASE_PATH=/

# ── Database ──────────────────────────────────────────────────────────────────
# Local PostgreSQL connection (used by the API server inside AWS)
DATABASE_URL=postgresql://root_admin:YOUR_PASSWORD@localhost:5432/uat_ananta

# Remote/public PostgreSQL connection (used by the pipeline worker for cross-server copies)
# On AWS dev this is the public IP; in production use the private VPC address
CUSTOM_DATABASE_URL=postgresql://root_admin:YOUR_PASSWORD@YOUR_SERVER_IP:5432/uat_ananta

# ── Auth secrets ──────────────────────────────────────────────────────────────
# Generate all three with:  openssl rand -hex 32

# JWT access-token signing key (min 32 chars)
JWT_SECRET=replace_with_output_of_openssl_rand_hex_32

# JWT refresh-token signing key (min 32 chars)
REFRESH_TOKEN_SECRET=replace_with_output_of_openssl_rand_hex_32

# Express session secret
SESSION_SECRET=replace_with_output_of_openssl_rand_hex_64

# ── Python pipeline worker ────────────────────────────────────────────────────
# Path to the Python binary inside the virtualenv created by deploy-server.sh
# Run on AWS:  python3 -m venv /home/ubuntu/ananta-platform/venv
PYTHON_BIN=/home/ubuntu/ananta-platform/venv/bin/python3

# ── PII encryption ────────────────────────────────────────────────────────────
# AES-256-GCM key — must be exactly 64 hex characters
# Generate with:  openssl rand -hex 32
# WARNING: Losing this key means encrypted PII data cannot be decrypted. Back it up.
PII_ENCRYPTION_KEY=replace_with_output_of_openssl_rand_hex_32
