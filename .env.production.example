# ============================================================
# Ananta Platform — Production Environment Variables
# 
# SETUP INSTRUCTIONS:
#   1. Copy this file:  cp .env.production.example .env.production
#   2. Fill in your real values below
#   3. Never commit .env.production to git
# ============================================================

# PostgreSQL connection string (REQUIRED)
# Format: postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL=postgresql://your_user:your_password@your-rds-host.amazonaws.com:5432/your_db_name

# App port — API server listens on this
PORT=8080

# JWT secret — use a long random string (min 32 characters)
JWT_SECRET=replace_with_a_strong_random_secret_at_least_32_chars

# PII Encryption Key — AES-256-GCM key for encrypting sensitive fields (REQUIRED)
# Generate with:  openssl rand -hex 32
# Must be exactly 64 hexadecimal characters. Keep this secret and back it up —
# losing it means encrypted PII data cannot be decrypted.
PII_ENCRYPTION_KEY=replace_with_output_of_openssl_rand_hex_32

# Node environment
NODE_ENV=production
