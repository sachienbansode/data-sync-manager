{
  "info": {
    "name": "Ananta Platform API",
    "description": "Complete API collection for the Ananta Tech / Ashika Group platform. Set the collection variables before running.\n\n**Authentication flow:**\n1. Run `POST /auth/login` — the access token and refresh token are saved automatically.\n2. All other requests use `{{access_token}}` as a Bearer token automatically.\n3. When the access token expires, run `POST /auth/refresh`.\n\n**External API:** Use `{{api_key}}` (generate via Admin → API Keys).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:3000/api", "description": "API base URL. Change to your AWS dev host, e.g. http://13.233.x.x/api" },
    { "key": "access_token", "value": "", "description": "JWT access token — auto-filled by the Login request" },
    { "key": "refresh_token", "value": "", "description": "Opaque refresh token — auto-filled by the Login request" },
    { "key": "api_key", "value": "", "description": "External API key (apk_...) — generate from Admin → API Keys" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [{ "listen": "test", "script": { "exec": [
            "const r = pm.response.json();",
            "if (r.accessToken)  pm.collectionVariables.set('access_token',  r.accessToken);",
            "if (r.refreshToken) pm.collectionVariables.set('refresh_token', r.refreshToken);"
          ], "type": "text/javascript" }}],
          "request": {
            "method": "POST", "auth": { "type": "noauth" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"yourpassword\"\n}" },
            "url": { "raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": { "raw": "{{base_url}}/auth/logout", "host": ["{{base_url}}"], "path": ["auth", "logout"] }
          }
        },
        {
          "name": "Refresh Token",
          "event": [{ "listen": "test", "script": { "exec": [
            "const r = pm.response.json();",
            "if (r.accessToken)  pm.collectionVariables.set('access_token',  r.accessToken);",
            "if (r.refreshToken) pm.collectionVariables.set('refresh_token', r.refreshToken);"
          ], "type": "text/javascript" }}],
          "request": {
            "method": "POST", "auth": { "type": "noauth" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refresh_token}}\"\n}" },
            "url": { "raw": "{{base_url}}/auth/refresh", "host": ["{{base_url}}"], "path": ["auth", "refresh"] }
          }
        },
        {
          "name": "Get Current User (Me)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/auth/me", "host": ["{{base_url}}"], "path": ["auth", "me"] }
          }
        },
        {
          "name": "Change Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"currentPassword\": \"oldpassword\",\n  \"newPassword\": \"newpassword\"\n}" },
            "url": { "raw": "{{base_url}}/auth/change-password", "host": ["{{base_url}}"], "path": ["auth", "change-password"] }
          }
        },
        {
          "name": "MFA — Setup",
          "request": {
            "method": "POST", "header": [],
            "url": { "raw": "{{base_url}}/auth/mfa/setup", "host": ["{{base_url}}"], "path": ["auth", "mfa", "setup"] }
          }
        },
        {
          "name": "MFA — Confirm Setup",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"code\": \"123456\"\n}" },
            "url": { "raw": "{{base_url}}/auth/mfa/confirm", "host": ["{{base_url}}"], "path": ["auth", "mfa", "confirm"] }
          }
        },
        {
          "name": "MFA — Verify (Login Step 2)",
          "request": {
            "method": "POST", "auth": { "type": "noauth" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"tempToken\": \"\",\n  \"code\": \"123456\"\n}" },
            "url": { "raw": "{{base_url}}/auth/mfa/verify", "host": ["{{base_url}}"], "path": ["auth", "mfa", "verify"] }
          }
        },
        {
          "name": "MFA — Disable",
          "request": {
            "method": "POST", "header": [],
            "url": { "raw": "{{base_url}}/auth/mfa/disable", "host": ["{{base_url}}"], "path": ["auth", "mfa", "disable"] }
          }
        },
        {
          "name": "M365 SSO — Initiate",
          "request": {
            "method": "GET", "auth": { "type": "noauth" }, "header": [],
            "url": { "raw": "{{base_url}}/auth/m365", "host": ["{{base_url}}"], "path": ["auth", "m365"] }
          }
        },
        {
          "name": "M365 SSO — Exchange Code",
          "request": {
            "method": "POST", "auth": { "type": "noauth" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"code\": \"sso-one-time-code\"\n}" },
            "url": { "raw": "{{base_url}}/auth/m365/exchange", "host": ["{{base_url}}"], "path": ["auth", "m365", "exchange"] }
          }
        }
      ]
    },
